@DOC ver=2.0 | id=orient-roadmap-example | title="Example emitted orientation record (orient-roadmap on a git repo with a plan)" | kind=context | profile=exec | fmt=min | guide="https://yon.younndai.com/yon-guide.txt"
@NOTE text="Synthetic contract example: values and source labels illustrate hypothetical inputs, not observations of a live project. Every emitted payload field or collection entry has an exact rider; illustrative-premise is not runtime attestation."
@INTENT goal="A worked, validatable instance of the roadmap slice of orient-record showing the reserved-tag emission with the 3-node increment arc, the runway, and a sidecar @MAP for every list field (never an in-set bracket-list)." | audience=agent
@STAMP ts:ts=2026-11-04T15:10:09Z | src="Alexandru Mares | allemaar.com" | method=manual
@NOTE text="Apache-2.0. Conforms to orient-spec/orient-record.yon (schema_version orient-record/1). Every list field is a sidecar @MAP — never a bare in-set bracket-list. The star (paramount) and the deferred dot ride inside the item label as render hints, never as tier glyphs."

@CFG id=orient | set=[schema_version=orient-record/1,computed_at:ts=2026-07-07T00:00:00Z,ephemeral:bool=true,tool=orient-roadmap,tier=orient,scope=open-skills,evidence_mode=git-only,gate_status=degraded,gate_score:int=70,gate_blocking_field=none,gate_confidence_floor=inferred,family_used=orient-roadmap,family_suggested_next=orient-status,family_reason_code=lost_thread,overall_trust=med,degraded:bool=true,degrade_reason="inferred paramount item is advisory; no attested gate verdict"]
@CFG id=subject | set=[name=open-skills,kind=monorepo,purpose="public skills pack",purpose_source=readme,intent_status=stated,parent_subject="open-source push"]
@CFG id=roadmap | set=[north_star="one orient- family, three faces, machine-checked",arc_current=active,arc_idx:int=2,arc_count:int=3,now_count:int=4,next_count:int=3,runway_span="author to publish",paramount_ref="roadmap slice",cleanup_now_count:int=1,deferred_count:int=2]
@CFG id=node.a1 | set=[kind=increment,label=status,istatus=built,lane=arc]
@CFG id=node.a2 | set=[kind=increment,label=active,istatus=current,lane=arc]
@CFG id=node.a3 | set=[kind=increment,label=roadmap,istatus=next,lane=arc]
@MAP name=edges | pairs=["a1"->"a2","a2"->"a3"]
@MAP name=built_items | pairs=["b1"->"orient-status","b2"->"orient-map","b3"->"orient-gaps","b4"->"value-gate"]
@MAP name=gates | pairs=["g1"->"full validate green","g2"->"cold-review pass"]
@MAP name=next_items | pairs=["x1"->"★ roadmap slice","x2"->"widget parity","x3"->"ascii floor"]
@MAP name=runway_stages | pairs=["r1"->"now: author","r2"->"gated-next: cold-review","r3"->"future: publish"]
@MAP name=cleanup_now | pairs=["u1"->"⚠ stale STAMP dates"]
@MAP name=deferred | pairs=["d1"->"◌ deterministic renderer (deferred)","d2"->"◌ ci wiring (deferred)"]
@MAP name=provenance | pairs=["roadmap.arc_current"->"artifact-stated:med:plan-md","roadmap.built_items"->"git-attested:high:git-log","roadmap.gates"->"git-attested:high:ci-config","roadmap.next_items"->"inferred:med:plan-md","roadmap.runway_stages"->"inferred:med:plan-md","roadmap.paramount_ref"->"inferred:med:plan-md","roadmap.deferred"->"artifact-stated:med:deferred-goal","roadmap.cleanup_now"->"artifact-stated:med:arc-state","subject.name"->"inferred:low:illustrative-premise","subject.kind"->"inferred:low:illustrative-premise","subject.purpose"->"inferred:low:illustrative-premise","subject.purpose_source"->"inferred:low:illustrative-premise","subject.intent_status"->"inferred:low:illustrative-premise","subject.parent_subject"->"inferred:low:illustrative-premise","roadmap.north_star"->"inferred:low:illustrative-premise","roadmap.arc_idx"->"inferred:low:illustrative-premise","roadmap.arc_count"->"inferred:low:illustrative-premise","roadmap.now_count"->"inferred:low:illustrative-premise","roadmap.next_count"->"inferred:low:illustrative-premise","roadmap.runway_span"->"inferred:low:illustrative-premise","roadmap.cleanup_now_count"->"inferred:low:illustrative-premise","roadmap.deferred_count"->"inferred:low:illustrative-premise","node.a1.kind"->"inferred:low:illustrative-premise","node.a1.label"->"inferred:low:illustrative-premise","node.a1.istatus"->"inferred:low:illustrative-premise","node.a1.lane"->"inferred:low:illustrative-premise","node.a2.kind"->"inferred:low:illustrative-premise","node.a2.label"->"inferred:low:illustrative-premise","node.a2.istatus"->"inferred:low:illustrative-premise","node.a2.lane"->"inferred:low:illustrative-premise","node.a3.kind"->"inferred:low:illustrative-premise","node.a3.label"->"inferred:low:illustrative-premise","node.a3.istatus"->"inferred:low:illustrative-premise","node.a3.lane"->"inferred:low:illustrative-premise","edges.a1"->"inferred:low:illustrative-premise","edges.a2"->"inferred:low:illustrative-premise","built_items.b1"->"i