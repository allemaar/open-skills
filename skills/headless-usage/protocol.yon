@DOC ver=2.0 | kind=skill | id=headless-usage | title="On-demand headless harness quota and usage" | profile=exec | fmt=min | guide="https://yon.younndai.com/yon-guide.txt"
@INTENT goal="Read current quota and reset times across requested harnesses with explicit availability and freshness" | trigger="user runs /headless-usage or asks for quotas or remaining usage"
@STAMP ts:ts=2026-10-31T10:00:42.005Z | src=human | method=manual
@RULE rid=rule:read-only | lvl=MUST_NOT | when="querying usage" | then="launch inference, extract credentials, consume reset credits, enable overage, change settings or install collectors"
@RULE rid=rule:freshness | lvl=MUST | when="each invocation" | then="attempt current reads independently; record source and observation time per provider; do not gate quota on the configured model-map reminder interval"
@RULE rid=rule:bounded | lvl=MUST | when="running a process" | then="retain handles, finite deadlines and cancellation; on watchdog or interruption cancel active owned reads and wait a bounded cleanup grace; retain completed results and incomplete cleanup evidence before exit; inspect completion and cleanup; never claim live success after unverified cleanup"
@RULE rid=rule:claude | lvl=MUST | when="reading Claude quota" | then="use supervised interactive /usage and wait for refresh, or label an existing status-line capture cached with age; without access report unavailable; never infer fresh backend data from capture time or use print inference to populate fields"
@RULE rid=rule:grok | lvl=MUST | when="reading Grok quota" | then="read references/grok-interactive.md for this route; use an existing authenticated surface or a supervised installed native TUI in an authorized known directory with retained handle and finite deadline; inspect startup prompts and wait for /usage refresh; record exact bucket, raw percentage, reset label, observation time and freshness; verify percentage direction, display precision and timezone against applicable evidence; modal opening can show cached data while requesting refresh, so label backend freshness unverified without proof of a fresh response; verify termination and report scoped forced cleanup when needed; keep session accounting separate from quota; without usable access or supervision return unavailable with manual /usage or Settings -> Usage action"
@RULE rid=rule:grok-prompts | lvl=MUST_NOT | when="starting or controlling Grok for quota" | then="send inference prompts, accept trust for an unauthorized folder, change permission defaults, billing or training preferences, infer API credits from a subscription, or describe startup as free of hooks or MCP effects"
@RULE rid=rule:semantics | lvl=MUST | when="reporting" | then="keep pools and harness accounts separate; null means unknown; precise remaining percentage is clamped 100 minus used, but rounded or truncated displays retain bounds rather than false precision; session tokens, local history, estimated costs and credits are not remaining subscription quota"
@RULE rid=rule:privacy | lvl=MUST | when="retaining diagnostics" | then="use a new private no-link directory, keep raw account replies local, emit only normalized nonsecret fields and preserve partial results"
@SEC name="Workflow"
@STEP rid=step:discover | n:int=1 | op=std:ai.prompt@v1 | args=[task="Read provider reference; default to Codex, Claude Code, Antigravity and Grok Build unless a narrower set is requested; discover native executables and existing usage tools without installing or logging in."] | out=[ref:scope]
@STEP rid=step:query | n:int=2 | op=std:cmd.run@v1 | in=[ref:scope] | args=[task="Use native usage tool or bundled Windows direct reader with a fresh private spec/output; query each harness independently and retain bounded process evidence."] | out=[ref:direct]
@STEP rid=step:claude | n:int=3 | op=std:ai.prompt@v1 | in=[ref:direct] | args=[task="If terminal control exists, read Claude /usage under supervision without inference or permission-default changes, wait for live refresh and exit; otherwise label an existing capture cached or report unavailable. Keep this observation distinct from direct JSON."] | out=[ref:observations]
@STEP rid=step:grok | n:int=4 | op=std:ai.prompt@v1 | in=[ref:observations] | args=[task="Load references/grok-interactive.md; read authenticated Grok /usage interactively under bounded supervision or Settings -> Usage with existing control. Inspect prompts, wait for refresh, capture rendered quota labels and verify process exit; keep session accounting and API billing/rate tiers separate. No direct reader exists; return dated observations with verified or unverified backend freshness, cleanup exceptions or unavailable with the manual action."] | out=[ref:all-observations]
@STEP rid=step:report | n:int=5 | op=std:io.emit@v1 | in=[ref:all-observations] | args=[task="Return compact per-bucket remaining percentages or bounds, verified local reset times, observation times, freshness status, useful sourced insights and concrete access gaps. Distinguish live, cached, backend freshness unverified and unavailable. Do not silently switch models or spend credits."] | out=[ref:report]
@STEP rid=step:sip | n:int=99 | op=std:ai.prompt@v1 | args=[task="Propose a concrete repair only for a material or recurring weakness, missing good practice, or unrecorded fixed pitfall; otherwise remain silent and never auto-apply."] | out=[ref:sip]

@RULE rid=rule:access-contract | lvl=MUST | when="every run" | then="read bundled access.md; census current OS, executable path, version/help, supported nonsecret auth state, model/quota surfaces, relevant configuration/customizations and parent supervision/cancellation; use only existing state; missing or unobservable capabilities stop only dependent routes; dated validation is historical, never a default or entitlement; never auto-install, log in, add API fallback or change configuration"
