@DOC ver=2.0 | kind=skill | id=headless-update-models | title="Refresh the headless model family" | profile=exec | fmt=min | guide="https://yon.younndai.com/yon-guide.txt"
@INTENT goal="Refresh provider model and effort evidence with honest per-source dates and synchronized headless projections" | trigger="explicit /headless-update-models or update headless models request"
@STAMP ts:ts=2026-09-17T09:18:37.950Z | src=human | method=manual
@RULE rid=rule:scope | lvl=MUST | when="before mutation" | then="require explicit update request; resolve canonical source and exact supported consumer cohort; inspect no-follow paths and retain preimages; never write through runtime links"
@RULE rid=rule:authority | lvl=MUST_NOT | when="refreshing evidence" | then="change credentials, permissions, runtime defaults, create new runtime installations, enable credits, launch inference, schedule or publish"
@RULE rid=rule:evidence | lvl=MUST | when="researching" | then="use current primary provider and benchmark sources, exact IDs/efforts/harnesses and task relevance; distinguish availability, inference tests, benchmark costs, current API rates, workload estimates and subscription quota; unknown remains unknown"
@RULE rid=rule:timestamps | lvl=MUST | when="recording checks" | then="record source publication and actual last attempt/outcome independently; advance lastVerifiedAt only for successfully checked source; preserve old success on partial/failure; UTC ISO dates, historical day precision explicit; reminderDays is sole interval source"
@RULE rid=rule:choice | lvl=MUST | when="updating guidance" | then="preserve explicit selections, permissions and supervision; compare useful lower/higher options only with task-relevant evidence; no coding-to-universal-quality inference"
@RULE rid=rule:cohort | lvl=MUST | when="projecting" | then="discover consumers; use reviewed projector targets, report unprojected consumers; stop on failure retaining backups and completed/pending state; refresh established copied/plugin installations through their verified installer retaining preimages, and verify installed targets and hashes separately"
@STEP rid=step:scope | n:int=1 | op=std:ai.prompt@v1 | args=[task="Resolve source, scope, consumers, metadata and preimages."] | out=[ref:scope]
@STEP rid=step:research | n:int=2 | op=std:ai.prompt@v1 | in=[ref:scope] | args=[task="Inspect CLI help/catalogs and primary models/pricing/benchmarks without inference. Verify endpoint, then fetch bounded private candidates. Reconcile prices and exact identities."] | out=[ref:evidence]
@STEP rid=step:update | n:int=3 | op=std:fs.write@v1 | in=[ref:evidence] | args=[task="Update canonical matrix and per-source state, affected model guidance and paired protocols; preserve scope and truthful partial dates."] | out=[ref:source]
@STEP rid=step:project | n:int=4 | op=std:cmd.run@v1 | in=[ref:source] | args=[task="Run projector check/apply/check; retain preimages. Validate protocols, lint/catalogs and actual installed bytes."] | out=[ref:verified]
@STEP rid=step:report | n:int=5 | op=std:io.emit@v1 | in=[ref:verified] | args=[task="Report changed recommendations, dates, checked/failed sources, provider coverage, parity, costs and gaps; no false cohort success."] | out=[ref:report]
@STEP rid=step:sip | n:int=99 | op=std:ai.prompt@v1 | args=[task="Propose a repair only for recurring/blocking weakness; never auto-apply."] | out=[ref:sip]
@RULE rid=rule:usage-maintenance | lvl=MUST | when="refreshing affected family guidance and installations" | then="include headless-usage provider references and test changed readers without inference; preserve real research dates; keep live quota values outside catalog evidence and do not add model-map projection or reminder gates to quota queries"

@RULE rid=rule:access-contract | lvl=MUST | when="every run" | then="read bundled access.md; census current OS, executable path, version/help, supported nonsecret auth state, model/quota surfaces, relevant configuration/customizations and parent supervision/cancellation; use only existing state; missing or unobservable capabilities stop only dependent routes; dated validation is historical, never a default or entitlement; never auto-install, log in, add API fallback or change configuration"

@RULE rid=rule:source-unavailable | lvl=MUST | when="canonical source or a local CLI is missing" | then="continue reachable evidence collection into a private candidate, preserve unavailable source timestamps, and report applying/installing blocked without canonical source; never silently edit installed copies"

@RULE rid=rule:process-assets | lvl=MUST | when="projecting the provider execution cohort" | then="project canonical run-process and dispatch-fixed scripts plus their references from headless-models to the four provider skills: headless-codex, headless-claude, headless-gemini and headless-grok; preserve provider-specific parsers and do not add inference to the updater"
