@DOC ver=2.0 | id=skill-library-creator | title="Create self-contained skill libraries and family managers" | kind=skill | profile=exec | fmt=min | guide="https://yon.younndai.com/yon-guide.txt"
@STAMP ts:ts=2026-10-30T16:16:10Z | src=maintainer | method=manual
@INTENT goal="Create a portable library with guided setup, a self-contained family manager, authoring resources and on-demand local links"
@SEC name="Rules"
@RULE rid=rule:scope | lvl=MUST | when="creating or upgrading" | then="Use the selected physical library and this machine's selected harness scope; do not operate transport, permissions, external publication or global directives"
@RULE rid=rule:paths | lvl=MUST | when="before filesystem mutation" | then="Use the selected physical filesystem adapter within host policy; confirm mounted volume and cloud roots when required; inspect native mount coordinates including same-device boundaries; compare existing path identity without blanket case folding; reject unsupported redirects and metadata; preserve recovery and recheck current bytes"
@RULE rid=rule:standalone | lvl=MUST | when="generating a manager" | then="Bundle required references scripts and templates; keep private machine settings outside shared sources; make external enhancements optional"
@RULE rid=rule:walkthrough | lvl=MUST | when="guiding use" | then="Explain briefly, collect only missing settings, preview exact targets and tour the actual result; expand only the selected capability"
@RULE rid=rule:links | lvl=MUST | when="reconciling" | then="Discover live physical family sources; create direct complete-directory links; remove only recorded links after confirmed retirement; absence never proves deletion"
@RULE rid=rule:upgrade | lvl=MUST | when="upgrading generated managers" | then="Bind apply to the reviewed plan digest including current incoming hashes and render date; refuse downgrades and missing managed files; verify stored baseline bytes and retain old baselines and config; preserve customizations through a reviewed merge and advance verified baseline bytes hashes and generator version date together"
@RULE rid=rule:activation | lvl=MUST | when="importing or authoring skills" | then="Reject duplicate recognized metadata keys empty descriptions and invalid semantic versions or dates; bind metadata reads and complete copies to their captured snapshots; publish reviewed complete content only and verify activated bytes before success; preserve locks and recovery on mismatch; expose source digests independently of installation targets; apply requires the reviewed draft digest; replacements require the current digest and retain the old tree; malformed metadata repairs require explicit review and repair flag"
@RULE rid=rule:adoption | lvl=MUST | when="adopting or releasing callers" | then="Preflight links and same-device recovery outside caller discovery before bookkeeping; reject existing private or pending shared adoption attempts; retain private paths and shared opaque dependencies; block rename on either private or shared dependencies; release only after caller removal or repointing away from historical and current library targets is reviewed; never delete caller or recovery files on release"
@RULE rid=rule:interruption | lvl=MUST | when="a mutation was interrupted" | then="Block new mutations pending exact operation-specific recovery; source writers share a lock but private installation can overlap other-machine writers; rechecks may stop a partial install; offline synced copies are not coordinated"
@RULE rid=rule:primer | lvl=SHOULD | when="considering a separate primer" | then="Use the manager as the default family inventory; add a primer only for useful domain context or source routing"
@RULE rid=rule:evaluation | lvl=SHOULD | when="changing task behavior routing or generated manager behavior" | then="Load the bundled evaluation reference for the selected change; report weaknesses and repair only when edits are authorized through bundled authoring; route variant behavior edits through authoring; use realistic cases and observable criteria; exercise plausible bypass when safeguards change and another input when generalization is uncertain; simulate hazardous effects; support efficiency claims with available measurements; distinguish preservation from improvement; report unobserved routing or portability honestly; require no particular host or evaluation package"
@RULE rid=rule:improvement-opt-in | lvl=MUST | when="creating an individual skill" | then="Ask once whether to bundle self-contained improvement proposals unless already answered; decline omits flag route and reference; enabling existing skills needs a request; run only after the opted-in skill performs its own task outside authoring assessment evaluation import or publication; concrete material or repeated lessons need specific proposals and explicit approval of the latest shown revision; a revision request authorizes proposal only; unavailable guarded tooling or read-only storage keeps the draft private without applying; remain silent otherwise"
@RULE rid=rule:assessment | lvl=SHOULD | when="assessing or boiling an existing skill" | then="Load assessment and the bundled authoring contract without the write procedure until edits are authorized; judge useful detail and selected-route reading cost; distinguish unresolved authoring placeholders from labeled runtime fields in reusable output templates; propose the smallest meaningful edit; preserve behavior safeguards and provenance; brevity alone is not success"
@RULE rid=rule:upstream-comparison | lvl=MUST | when="using compare-upstream" | then="Operate offline and read-only on verified retained baseline current and acquired incoming trees; use portable path type content identity while preserving native mode observations and full local write guards; derive legacy identity only from its verified original snapshot; expose raw hashes loader adaptation and provenance review; never merge or advance provenance automatically"
@RULE rid=rule:recovery-guidance | lvl=MUST | when="an operation is interrupted" | then="Load bundled operation-specific recovery guidance; correlate available receipt and lock identities with actual paths and bytes; retain uncertainty and never infer that a lock may be cleared from its age"
@SEC name="Creation"
@STEP rid=step:settings | n:int=1 | op=std:ai.prompt@v1 | args=[task="Read creation guidance then explain the result and resolve parent folder family prefix supplied purpose global or project scope and actual harness targets"] | out=[ref:settings]
@STEP rid=step:preview | n:int=2 | op=std:ai.prompt@v1 | args=[task="Read creation and selected installation guidance, inspect physical paths and preview every manager baseline README and configuration file plus user-selected installation targets; distinguish conventional candidates from detected existing roots"] | in=[ref:settings] | out=[ref:preview]
@CHECK rid=check:targets | assert="Physical sources and selected targets are safe, scope is authorized and collisions are resolved" | fail=ABORT | msg="Report the exact blocker; do not replace an existing library or installation"
@STEP rid=step:create | n:int=3 | op=std:ai.prompt@v1 | args=[task="Generate complete manager README config references scripts and templates; configure private targets and reconcile authorized links"] | in=[ref:preview] | out=[ref:created]
@STEP rid=step:verify | n:int=4 | op=std:ai.prompt@v1 | args=[task="Verify live inventory, exact targets and linked bytes; show result and help routes; keep runtime pickup and other-machine state unverified unless observed"] | in=[ref:created] | out=[ref:verified]
@SEC name="Upgrade"
@STEP rid=step:upgrade | n:int=5 | op=std:ai.prompt@v1 | args=[task="On an upgrade request read upgrade reference, compare baseline current incoming, show exact differences, apply only the reviewed nonconflicting change and verify recovery and status"] | out=[ref:upgrade]
@STAMP ts:ts=2026-10-30T16:16:10Z | src=maintainer | method=manual
