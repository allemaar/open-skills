@DOC ver=2.0 | kind=skill | id=headless-models | title="Provider-wide model selection and maintenance" | profile=exec | fmt=min | guide="https://yon.younndai.com/yon-guide.txt"
@INTENT goal="Select models and efforts against requested output, quality, cost, latency and local availability; read synchronized evidence maps across headless skills" | trigger="user runs /headless-models, asks which model to use, compares models and effort, or compares provider setups"
@STAMP ts:ts=2026-09-17T09:18:37.950Z | src=human | method=manual
@RULE rid=rule:no-runtime-mutation | lvl=MUST_NOT | when="selecting or maintaining the map" | then="change runtime defaults, credentials, provider billing, subscription, credits, installation, scheduling or publication; launch comparison inference without bounded authorization"
@RULE rid=rule:output-contract | lvl=MUST | when="selecting" | then="establish artifact, task family, acceptance checks, failure consequence, modalities and input size, tools, privacy, availability, budget and latency; label reasonable inferences and ask only for a decision-changing missing constraint"
@RULE rid=rule:providers | lvl=MUST | when="defining coverage" | then="discover providers from relevant sources, keep unavailable providers comparison-only, and report the covered set without claiming universal completeness"
@RULE rid=rule:evidence-layers | lvl=MUST | when="gathering evidence" | then="separate runtime availability, exact provider/model capabilities and billing, benchmark performance and local execution; record sources, dates, effort, harness, metric, uncertainty and sample counts"
@RULE rid=rule:discovery | lvl=MUST | when="probing runtimes" | then="use supported read-only local help/catalog commands, filter hidden Codex models, print only relevant catalog fields, use provider-aware Claude alias resolution, never inspect credentials or install a missing CLI"
@RULE rid=rule:identity | lvl=MUST_NOT | when="joining evidence" | then="equate aliases, preview or newer model versions, different harnesses, or missing effort combinations without evidence; turn missing scores into zero or extrapolated scores"
@RULE rid=rule:task-fit | lvl=MUST | when="using a benchmark" | then="restrict inference to relevant task families; DeepSWE is coding evidence, not universal quality; obtain other primary evaluations or label task quality unmeasured"
@RULE rid=rule:cost | lvl=MUST | when="comparing costs" | then="distinguish benchmark costs, current API rates, task estimates and subscription quota; reconcile source conflicts or mark unknown, account for applicable cache/reasoning/tool/context charges, and do not treat unknown cost as satisfying a hard ceiling"
@RULE rid=rule:choice | lvl=MUST | when="recommending" | then="filter mandatory constraints first, compare the full measured effort ladder with uncertainty, recommend one feasible setup plus justified cheaper/stronger alternatives and reversal conditions, and never interpret benchmark pass rate as task success probability"
@RULE rid=rule:explicit-selection | lvl=MUST | when="caller already selected model or effort" | then="preserve the choice until a proposed change is accepted; never silently change provider, billing or credits, and do not claim ability to change the parent model"
@SEC name="Workflow"
@STEP rid=step:scope | n:int=1 | op=std:ai.prompt@v1 | args=[task="Resolve operation, output requirements, provider/source coverage and authorized canonical sources or private candidate destination."] | out=[ref:scope]
@STEP rid=step:discover | n:int=2 | op=std:cmd.run@v1 | in=[ref:scope] | args=[task="Inspect relevant installed CLI help and model/effort catalogs without credentials or inference; retain compact availability evidence."] | out=[ref:availability]
@STEP rid=step:research | n:int=3 | op=std:ai.prompt@v1 | in=[ref:scope,ref:availability] | args=[task="Refresh primary benchmark, methodology, provider capability and price sources. Inspect full effort ladders; compare displayed and downloadable costs; keep missing and conflicting fields explicit."] | out=[ref:evidence]
@STEP rid=step:select | n:int=4 | op=std:ai.prompt@v1 | in=[ref:evidence] | args=[task="Filter hard constraints, construct task-fit quality/cost/latency/availability matrix and make labeled recommendations. Preserve explicit choices; propose justified upgrade/downgrade with trade-off and reversal condition."] | out=[ref:matrix]
@STEP rid=step:verify | n:int=6 | op=std:cmd.run@v1 | in=[ref:matrix] | args=[task="Verify recommendation facts against retrieved primary evidence and actual runtime availability; report missing coverage."] | out=[ref:verified]
@STEP rid=step:report | n:int=7 | op=std:io.emit@v1 | in=[ref:verified] | args=[task="Return selection/update result, useful up/down alternative, evidence dates, cost basis, provider/runtime coverage, installed state and material gaps; no giant catalog by default."] | out=[ref:report]
@STEP rid=step:sip | n:int=99 | op=std:ai.prompt@v1 | args=[task="Propose a concrete repair only for recurring or blocking weakness; otherwise remain silent and never auto-apply."] | out=[ref:sip]

@RULE rid=rule:freshness | lvl=MUST | when="every invocation, even with an explicit model" | then="read model-state.json and freshness.md; run bundled local checker or apply identical timestamp logic; interval comes from policy.reminderDays; parent offers update-all or continue-dated once per session snapshot/reasons; children return status, never ask or update recursively; no reply is no update approval"
@RULE rid=rule:read-only | lvl=MUST_NOT | when="using this selector" | then="edit projections, launch inference or change settings; route explicit update requests to headless-update-models"

@RULE rid=rule:access-contract | lvl=MUST | when="every run" | then="read bundled access.md; census current OS, executable path, version/help, supported nonsecret auth state, model/quota surfaces, relevant configuration/customizations and parent supervision/cancellation; use only existing state; missing or unobservable capabilities stop only dependent routes; dated validation is historical, never a default or entitlement; never auto-install, log in, add API fallback or change configuration"
