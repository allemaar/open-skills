@DOC ver=2.0 | id=insight-assess | title="Structured Decision Evaluation — Pros/Cons/Impact/Verdict" | kind=skill | profile=exec | fmt=min | guide="https://yon.younndai.com/yon-guide.txt"
@INTENT goal="Evaluate an approach, decision, option, or implementation across multiple dimensions and deliver a committed recommendation" | trigger="user runs /assess, asks for evaluation/comparison/impact analysis, or wants a structured pros-cons-recommendation pass"
@STAMP ts:ts=2026-10-26T00:09:21Z | src="Alexandru Mares | allemaar.com" | method=manual

# --- Governance ---

@SEC name="Governance"
@RULE rid=rule:concrete | lvl=MUST | when="listing pros and cons" | then="cite actual code, libraries, patterns, or domain evidence. No vague generalizations."
@RULE rid=rule:evidence | lvl=MUST | when="evaluating" | then="For decision-changing claims, trace support to original observations and count repetitions of the same upstream evidence once; distinguish new evidence from repetition. Preserve material contradictions, unresolved disagreement and unknown source dependence. Do not require a source quota or treat model agreement as independent evidence."
@RULE rid=rule:full-quality | lvl=MUST | when="evaluating" | then="For software decisions and software components, check performance, DX, and maintainability — not just correctness; use relevant domain criteria otherwise"
@RULE rid=rule:consistent-dims | lvl=MUST | when="comparing multiple options" | then="use the same dimensions across all options"
@RULE rid=rule:no-execution | lvl=MUST_NOT | when="assessing" | then="make changes, write code, or execute — evaluation only"
@RULE rid=rule:no-hedge | lvl=MUST_NOT | when="rendering verdict" | then="hedge without a clear verdict — always commit to a recommendation"
@RULE rid=rule:caveats | lvl=SHOULD | when="recommending PROCEED" | then="note caveats or conditions even if minor"
@RULE rid=rule:alternatives | lvl=SHOULD | when="recommending RECONSIDER or REJECT" | then="suggest concrete alternatives"

# --- Phase 1: Frame the Decision ---

@SEC name="Phase 1 — Frame the Decision"
@STEP rid=step:frame | n:int=1 | op=std:ai.prompt@v1 | args=[task="Identify what is being assessed: specific approach, decision between options, implementation pattern, or architectural direction. Load relevant context — files, docs, KIs, skills. Define what we are optimizing for and the constraints."] | out=[ref:framing] | note="Phase 1 — define the subject and the optimization target."
@CHECK rid=check:framed | assert="ref:framing has clear subject" | fail=ABORT | msg="Cannot assess without a clear subject. Ask the user to clarify before proceeding."

# --- Phase 2: Dimensional Analysis ---

@SEC name="Phase 2 — Dimensional Analysis"
@RULE rid=rule:optional-method | lvl=MUST | when="caller requests a method or decision structure warrants it" | then="Read only the selected reference: references/decision-tree.md for sequential uncertain choices; references/swot-tows.md for strategic situation and positioning; references/impact-effort.md for candidate actions competing for capacity. Apply it within dimensional analysis, then retain the existing alignment and verdict. Do not run all methods by default. Remain evaluation-only, cite material evidence, label assumptions and unknowns, and never invent scores or probabilities. Keep expected benefit in prioritization separate from change exposure (blast radius and disruption). Apply verdicts to feasible options under obligations and constraints; a benefit score cannot cancel mandatory work. If missing evidence prevents a defensible choice, use RECONSIDER and name what would resolve it rather than fabricate a rating or winner."
@NOTE text="Skip dimensions that don't apply. Score applicable dimensions STRONG/ADEQUATE/WEAK with justification."

@STEP rid=step:pros-cons | n:int=2 | op=std:ai.prompt@v1 | args=[task="List concrete advantages and disadvantages. Cite actual code, dependencies, patterns, or relevant domain evidence. If comparing multiple options, do side-by-side."] | in=[ref:framing] | out=[ref:pros-cons] | rules=[rid:rule:concrete,rid:rule:consistent-dims]

@MAP name=QualityDimensions | pairs=["Performance"->"bundle size, runtime overhead, N+1 queries, render cycles","Code-quality"->"DRY violations, coupling, testability, readability","Developer-experience"->"API ergonomics, debugging ease, onboarding friction","Maintainability"->"upgrade path, community support, lock-in risk"]
@STEP rid=step:quality | n:int=3 | op=std:ai.prompt@v1 | args=[task="For software decisions retain all applicable QualityDimensions; for other domains select relevant criteria consistently across options. Score each applicable dimension STRONG, ADEQUATE, or WEAK with justification."] | in=[ref:framing,ref:pros-cons] | use=[cfg:QualityDimensions] | out=[ref:quality] | rules=[rid:rule:full-quality]

@MAP name=ImpactDimensions | pairs=["Blast-radius"->"which packages, apps, or files are affected","Migration-effort"->"if replacing something","Breaking-changes"->"if any","Learning-curve"->"for the team","Future-flexibility"->"does this open or close doors?"]
@STEP rid=step:impact | n:int=4 | op=std:ai.prompt@v1 | args=[task="Map applicable impact dimensions, using domain-relevant effects for non-software decisions. Classify overall impact as LOW, MEDIUM, or HIGH."] | in=[ref:framing,ref:quality] | use=[cfg:ImpactDimensions] | out=[ref:impact]

@STEP rid=step:method | n:int=5 | op=std:ai.prompt@v1 | args=[task="If requested or warranted, apply only the selected optional method and retain its evidence, options, conditional policy or sequence for alignment and the final verdict. Otherwise skip silently with no extra report."] | in=[ref:framing,ref:pros-cons,ref:quality,ref:impact] | out=[ref:method-analysis] | rules=[rid:rule:optional-method]

# --- Phase 3: Alignment Check ---

@SEC name="Phase 3 — Alignment Check"
@STEP rid=step:alignment | n:int=6 | op=std:ai.prompt@v1 | args=[task="Check alignment with repo coding standards for software, applicable domain constraints otherwise, existing patterns, and prior art in skills and KIs. If this introduces a new pattern, is it justified?"] | in=[ref:framing,ref:quality,ref:impact,ref:method-analysis] | out=[ref:alignment]

# --- Phase 4: Recommendation ---

@SEC name="Phase 4 — Recommendation"
@MAP name=VerdictOptions | pairs=["all-dimensions-strong-impact-low"->"PROCEED","strong-but-with-caveats"->"PROCEED WITH CAVEATS","mixed-or-high-impact-with-concerns"->"RECONSIDER","weak-or-misaligned"->"REJECT"]

@STEP rid=step:verdict | n:int=7 | op=std:ai.prompt@v1 | args=[task="Synthesize all dimensions into a verdict from VerdictOptions. Provide RATIONALE (1–2 sentences). If PROCEED WITH CAVEATS: list CONDITIONS. If RECONSIDER or REJECT: provide ALTERNATIVES."] | in=[ref:pros-cons,ref:quality,ref:impact,ref:alignment,ref:method-analysis] | use=[cfg:VerdictOptions] | out=[ref:recommendation] | rules=[rid:rule:no-hedge,rid:rule:caveats,rid:rule:alternatives]
@CHECK rid=check:recommendation | assert="ref:recommendation includes verdict and rationale" | fail=ABORT | msg="Assessment is incomplete without a recommendation delivered to the user."

# --- Downstream ---

@SEC name="Downstream"
@MAP name=NextCommand | pairs=["verdict-proceed"->"/plan-create","more-options-needed"->"/insight-explore","deeper-review-of-output"->"/insight-critique"]


# --- Next Skills ---

@SEC name="Next Skills"
@STEP rid=step:nsp | n:int=99 | op=std:ai.prompt@v1 | args=[task="Run the Next Skills protocol: surface the next-skills front-matter recommendations for the caller to pick. Offer only; never auto-invoke. Skip silently if the next-skills list is empty."] | in=[] | out=[ref:nsp-offer]


# --- Self-improvement ---

@SEC name="Self-improvement"
@STEP rid=step:sip | n:int=100 | op=std:ai.prompt@v1 | args=[task="Run the Self-Improvement Protocol (self-improve/protocol.yon), which owns signal eligibility, cross-examination, and Handler approval. Conservative, silent otherwise; never auto-apply."] | in=[] | out=[ref:sip-offer]

@STAMP ts:ts=2026-10-26T00:09:21Z | src="Alexandru Mares | allemaar.com" | method=generated
