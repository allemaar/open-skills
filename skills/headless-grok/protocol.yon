@DOC ver=2.0 | kind=skill | id=headless-grok | title="Bounded Grok Build headless execution" | profile=exec | fmt=min | guide="https://yon.younndai.com/yon-guide.txt"
@INTENT goal="Run one supervised Grok Build CLI task while preserving model, authentication, permissions, cost route, scope and stop condition" | trigger="user runs /headless-grok, asks to run Grok headlessly, or asks to supervise grok -p"
@STAMP ts:ts=2026-09-17T09:18:37.950Z | src=human | method=manual
@RULE rid=rule:no-setup | lvl=MUST_NOT | when="using this execution skill" | then="install or update the CLI, authenticate, inspect credentials, change persistent settings, enable billing or credits, or infer API entitlement from X Premium or Grok subscription"
@RULE rid=rule:preflight | lvl=MUST | when="before launch" | then="read access, run contract, freshness and model state; verify local version/help/models; record exact task, paths, tools, model/reasoning, auth route, deadline, output, cancellation and retry limit"
@RULE rid=rule:auth | lvl=MUST | when="selecting identity and billing" | then="preserve explicit consumer OIDC or API-key route; prefer existing consumer login only when selected; require separate authorization and budget for API key; never print keys or silently fall back"
@RULE rid=rule:baseline | lvl=MUST | when="running a literal task" | then="use dontAsk, no subagents, no memory, no web, no auto-update and no tools by default; add only exact locally verified allow/tool scope required by the task"
@RULE rid=rule:isolation | lvl=MUST_NOT | when="on Windows" | then="claim sandbox containment or prompt-enforced read-only without independent target-version evidence"
@RULE rid=rule:supervision | lvl=MUST | when="launching" | then="use a foreground owned process with concurrent output capture, checkpoint within 60 seconds, external deadline, scoped cancellation and verified cleanup; no documented CLI hard timeout substitutes for this"
@RULE rid=rule:acceptance | lvl=MUST | when="closing" | then="require complete nonempty terminal result, expected model and auth route, no errors or denied actions, only approved tools and independent artifact or answer verification; exit zero alone is insufficient"
@RULE rid=rule:cost | lvl=MUST | when="discussing usage" | then="separate consumer shared weekly Chat/Imagine/Voice/Build pool from API credits, prices and rate limits; label unavailable quota; never invent a CLI usage command or stable schema"
@RULE rid=rule:access-contract | lvl=MUST | when="every run" | then="read bundled access.md; census current OS, executable path, version/help, supported nonsecret auth state, model/quota surfaces, relevant configuration/customizations and parent supervision/cancellation; use only existing state; missing or unobservable capabilities stop only dependent routes; dated validation is historical, never a default or entitlement; never auto-install, log in, add API fallback or change configuration"
@SEC name="Workflow"
@STEP rid=step:discover | n:int=1 | op=std:cmd.run@v1 | args=[task="Discover grok executable, version, help and model catalog without inference or credential access; stop dependent route when absent."] | out=[ref:runtime]
@STEP rid=step:scope | n:int=2 | op=std:ai.prompt@v1 | in=[ref:runtime] | args=[task="Record bounded task, exact scope, model/reasoning, auth and cost route, permissions, output artifact, deadline, monitoring, cancellation and retry limit."] | out=[ref:spec]
@STEP rid=step:launch | n:int=3 | op=std:cmd.run@v1 | in=[ref:spec] | args=[task="Launch with locally verified flags through an owned supervisor; retain stdout, stderr, process identity, session ID, actions, deadline and cleanup evidence."] | out=[ref:run]
@STEP rid=step:verify | n:int=4 | op=std:ai.prompt@v1 | in=[ref:run] | args=[task="Validate terminal structure, expected identity, scope and actions; independently verify answer or artifact and stopped state."] | out=[ref:verified]
@CHECK rid=check:complete | assert="run is complete, bounded, scope-conformant and independently verified" | fail=ABORT | msg="Return incomplete with exact blocker and retained evidence; do not substitute model, auth or billing route."
@STEP rid=step:report | n:int=5 | op=std:io.emit@v1 | in=[ref:verified] | args=[task="Report runtime, auth evidence without secrets, model/reasoning, permissions, deadline, result, verification and material gaps."] | out=[ref:report]
@STEP rid=step:sip | n:int=99 | op=std:ai.prompt@v1 | args=[task="Propose a concrete repair only for recurring or blocking weakness; otherwise remain silent and never auto-apply."] | out=[ref:sip]
