@DOC ver=2.0 | id=agent-mailbox-scheduled-collab | title="Agent Mailbox Scheduled Collab" | kind=workflow | profile=exec | fmt=min | classification=public | guide="https://yon.younndai.com/yon-guide.txt" | parent=agent-mailbox
@INTENT goal="Use a host runtime's native scheduler for bounded Agent Mailbox reconciliation checks without creating a daemon, overlapping jobs, or an unbounded autonomous cycle"
@STAMP ts:ts=2026-07-27T00:00:00Z | src="Alexandru Mares | allemaar.com" | method=merged

@SEC name="Package contract"
@NOTE text="Package id scheduled-collab version 2; compatible with Agent Mailbox base 1.x; participant-local directive whose activation cadence horizon checks expiry cancellation and cleanup never require peer acceptance"
@MAP rid=map:scheduled-outcomes | name=ScheduledCollabOutcomes | pairs=["ACTIVE"->"a native job is registered inside the approved horizon","FOUND"->"a valid addressed message was reconciled and the base exchange must run","PARKED"->"scheduler or task wake is unavailable but the base thread remains usable","DEGRADED"->"a scheduled check failed its evidence or budget contract","EXPIRED"->"the absolute horizon elapsed","CANCELLED"->"the job was removed and cleanup verified"]
@RULE rid=rule:native-scheduler-only | lvl=MUST | when="activating scheduled-collab" | then="use a host-exposed native scheduler or automation capability with a bounded job identity; never invent or install a daemon service database queue or universal wake layer"
@RULE rid=rule:absolute-horizon | lvl=MUST | when="registering scheduled checks" | then="set an absolute Handler-approved deadline, finite maximum check count, finite consecutive failure budget, and cancellation path"
@RULE rid=rule:no-overlap | lvl=MUST | when="a scheduled check fires while the prior owned check is still active" | then="skip the new check, record the overlap, and never run concurrent reconciliation jobs for the same package instance"
@RULE rid=rule:scheduled-lease-identity | lvl=MUST | when="a scheduled check uses a no-overlap lease" | then="bind it to the exact arena canonical mailbox root run nonce native-job or owned-process identity and creation identity; compare the complete declared identity plus content hash; honor a live exact owner; for a dead owner use identity-bound conditional rename or a held exclusive handle to move only that observed lease to a run-specific tombstone before create-new acquisition, otherwise refuse reclamation; release only through identity-bound conditional delete and never remove a successor"
@RULE rid=rule:handler-stale-lease-clear | lvl=MUST | when="a retained stale lease blocks activation after ordinary identity-bound recovery refused it" | then="a current Handler may authorize clearing one exact retained lease only from its durable stale-lease record naming arena canonical mailbox root observed hash nonce owner creation identity and refusal reason, after independent proof that the recorded holder and descendants are absent; use the same identity-bound conditional rename or held-exclusive-handle primitive required by ordinary recovery, delete only the verified run-specific tombstone, persist authorization and outcome, and require a fresh bounded readiness cycle; if that primitive is unavailable evidence changed a live holder exists or identity is ambiguous refuse the clear"
@RULE rid=rule:bounded-check | lvl=MUST | when="a scheduled check runs" | then="perform one bounded transport sync and age-independent disposition reconciliation, persist a structured outcome and heartbeat, then exit"
@RULE rid=rule:no-reply-keeps-schedule | lvl=MUST | when="scheduled reconciliation handles a valid message with expects-reply false or no wire response owed" | then="persist acted when an authorized effect completed or no-reply-required otherwise, advance the cursor last, and keep the existing bounded schedule unchanged; do not emit an acknowledgement or alter cadence solely because wire silence was requested"
@RULE rid=rule:transport-selected-check | lvl=MUST | when="a scheduled check selects its correctness action" | then="derive it from the resolved transport: local reconciles directly, sync-share waits for local provider materialization with bounded fresh-file retry, Git-only uses the approved scoped sync plus exact inbox range, Lyt uses lyt sync for the qualified vault plus exact inbox range, and Git inside sync-share requires the Handler-selected correctness channel"
@RULE rid=rule:no-stale-local-success | lvl=MUST_NOT | when="a required transport sync is unavailable or fails" | then="reconcile the stale local copy and report no-message or readiness; record PARKED before readiness or DEGRADED after a previously proven path fails"
@RULE rid=rule:quiet-git-feeler | lvl=MUST | when="a Git-backed mailbox uses a bounded background ref feeler before Codex task re-entry" | then="persist the last successfully reconciled remote ref outside the mailbox, keep unchanged ticks local and silent, sync and inspect only the exact inbox range on ref change, advance the baseline only after successful reconciliation, and wake the task once only for a valid addressed UUID or decision-relevant failure"
@RULE rid=rule:compact-conditional-wake | lvl=MUST | when="the feeler notifies a Codex task" | then="use a proven native conditional thread-wake or message capability with a damped pointer carrying mailbox identity new ref and candidate UUIDs; never inject message bodies private result paths diffs scan logs heartbeats or unchanged status"
@RULE rid=rule:no-feeler-wake-claim | lvl=MUST_NOT | when="the feeler lacks a proven conditional agent-task wake bridge" | then="claim post-turn LISTENING; persist a pending marker and report PARKED instead"
@RULE rid=rule:wake-honesty | lvl=MUST | when="describing scheduled operation" | then="separate successful job scheduling, folder materialization, message detection, and agent task wake; claim only the capabilities proven end to end"
@RULE rid=rule:scheduled-fallback | lvl=MUST | when="the runtime lacks a native scheduler or cannot prove wake and cancellation" | then="leave the base collaboration active, report PARKED, and offer Handler-mediated turn-taking or a bounded Collab Window"
@RULE rid=rule:no-infinite-schedule | lvl=MUST_NOT | when="a schedule has no absolute horizon or maximum check count" | then="register or continue it"
@RULE rid=rule:no-half-active-schedule | lvl=MUST_NOT | when="the scheduler capability check fails or any load-bearing prerequisite is absent" | then="register or run a scheduled job; terminate local package activation as PARKED while leaving the base collaboration active"
@RULE rid=rule:schedule-unilateral | lvl=MUST_NOT | when="selecting registering renewing expiring cancelling or cleaning up Scheduled Collab" | then="publish a mode proposal or require peer acceptance counter rejection renewal or matching cadence"
@RULE rid=rule:scheduled-peer-duty-separate | lvl=MUST | when="the local participant needs a peer to deliver review check reply or remain available by a deadline" | then="send an ordinary scoped request propose or FULL claim under the base protocol instead of encoding the duty as Scheduled Collab"

@SEC name="Execution"
@STEP rid=step:schedule-resolve | n:int=1 | op=std:ai.prompt@v1 | args=[task="Resolve the native scheduler capability, exact mailbox and participant filters, interval, absolute deadline, maximum check count, failure budget, no-overlap key, task-wake behavior, cancellation mechanism, result location, and cleanup evidence. If any load-bearing capability is absent, select PARKED."] | out=[ref:schedule-contract]
@CHECK rid=check:schedule-capable | assert="a native bounded scheduler, stable job identity, hard deadline, maximum check count, no-overlap guard, cancellation, result surface, and end-to-end task wake or agent re-entry mechanism are available and evidenced" | fail=ABORT | msg="Terminate this local package activation as PARKED before registration. Keep the base collaboration active."
@STEP rid=step:schedule-activate | n:int=2 | op=std:ai.prompt@v1 | in=[ref:schedule-contract] | args=[task="Activate scheduled-collab version 2 only for this participant after base establishment. Do not write a proposal or wait for peer acceptance. Optionally publish a canonical state availability FYI only for a material coarse transition, with expects_reply false and no peer obligation."] | out=[ref:schedule-local-state]
@STEP rid=step:schedule-register | n:int=3 | op=std:cmd.run@v1 | in=[ref:schedule-contract,ref:schedule-local-state] | args=[task="Register one native job with the absolute deadline, maximum check count, failure budget, and no-overlap key. Record the scheduler job identity and next due time. Do not create a watcher daemon or an unbounded shell loop."] | out=[ref:schedule-job]
@STEP rid=step:schedule-check | n:int=4 | op=std:cmd.run@v1 | in=[ref:schedule-contract,ref:schedule-job] | args=[task="At each firing, refuse overlap and select the correctness action from the resolved transport. Local reconciles directly; sync-share requires provider materialization with bounded fresh-file retry; Git-only runs the approved scoped sync then the exact inbox range; Lyt runs lyt sync for the qualified vault then the exact inbox range; Git inside sync-share uses only the Handler-selected channel. On unavailable or failed required sync emit PARKED before readiness or DEGRADED after proven readiness, never no-message from a stale copy. Otherwise reconcile the whole addressed inbox against durable dispositions and the compact cursor, emit FOUND or a no-message heartbeat, then exit before the next interval."] | out=[ref:schedule-result]
@STEP rid=step:schedule-react | n:int=5 | op=std:ai.prompt@v1 | in=[ref:schedule-result] | args=[task="On FOUND, re-enter the mandatory base exchange and persist the message disposition before any next check. On failure-budget exhaustion, cursor inconsistency, or missed message, mark DEGRADED and load missed-message-recovery. Never infer that a job firing means the agent task was woken unless re-entry is observed."] | out=[ref:schedule-state]
@STEP rid=step:schedule-stop | n:int=6 | op=std:cmd.run@v1 | in=[ref:schedule-contract,ref:schedule-job,ref:schedule-state] | args=[task="At cancellation deadline maximum checks or degradation, remove and verify the native job and owned process, release the canonical no-overlap lease only through full-identity conditional delete or held handle, leave changed state for stale recovery, remove owned tombstones and run-owned scheduler scratch, preserve the causal error, and record CANCELLED or EXPIRED only after complete cleanup; any retained exact stale lease is DEGRADED with the causal end reason recorded separately."] | out=[ref:schedule-terminal]
@CHECK rid=check:schedule-clean | assert="the exact native-job and owned-process identities are absent, their no-overlap lease is absent, run-owned scheduler scratch returned to baseline, and the terminal result preserves the causal error" | fail=ABORT | msg="Scheduled Collab cleanup is incomplete; remain DEGRADED and surface the owned resource or stale-lease debt."

@STAMP ts:ts=2026-07-27T00:00:00Z | src="Alexandru Mares | allemaar.com" | method=merged
