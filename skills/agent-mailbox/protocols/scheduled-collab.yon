@DOC ver=2.0 | id=agent-mailbox-scheduled-collab | title="Agent Mailbox Scheduled Collab" | kind=workflow | profile=exec | fmt=min | classification=public | guide="https://yon.younndai.com/yon-guide.txt" | parent=agent-mailbox
@INTENT goal="Use a host runtime's native scheduler for bounded Agent Mailbox reconciliation checks without creating a daemon, overlapping jobs, or an unbounded autonomous cycle"
@STAMP ts:ts=2026-07-29T22:31:23Z | src="Alexandru Mares | allemaar.com" | method=merged

@SEC name="Package contract"
@NOTE text="Package id scheduled-collab version 2; compatible with Agent Mailbox base 1.x; participant-local directive whose activation cadence horizon checks expiry cancellation and cleanup never require peer acceptance"
@RULE rid=rule:codex-default | lvl=MUST | when="Codex continued collaboration is requested without an explicit mechanism" | then="use this package through a host-native bounded heartbeat or equivalent bound to the exact Handler-visible task where collaboration started; surface that target task before registration; inject one compact reconciliation instruction into it per firing and do not present a mechanism menu"
@RULE rid=rule:codex-visible-task-binding | lvl=MUST | when="Codex activates this package" | then="prove the exact target is the Handler-visible task where collaboration was started and keep every found request project effect progress gate and result there; if exact binding or same-task re-entry is unavailable or unproven select PARKED and use Standard Exchange"
@RULE rid=rule:codex-no-dedicated-task | lvl=MUST_NOT | when="Codex registers a schedule or handles work found by it" | then="create fork select or delegate to a dedicated child standalone or automation task unless the Handler explicitly requested that topology"
@RULE rid=rule:visible-prompt-cost | lvl=MUST | when="Codex uses Scheduled Collab" | then="state that scheduled re-entry is visible and may add repetitive prompts; if the Handler declines that cost use Standard Exchange"
@RULE rid=rule:activation-circuit-breaker | lvl=MUST | when="activation or one bounded repair fails" | then="record the failure participant-locally against arena plus runtime, permit no second construction across session restart, use Standard Exchange, return to the project objective, and require a fresh explicit Handler mailbox-infrastructure task bound to one exact arena runtime adapter purpose and finite replacement run; consume that authority when the run terminates"
@MAP rid=map:scheduled-outcomes | name=ScheduledCollabOutcomes | pairs=["ACTIVE"->"a native job is registered inside the approved horizon and its health evidence is current or explicitly unevaluated under an exact current live turn","FOUND"->"actionable or valid outstanding work was reconciled and the base exchange must resume preserve or escalate its lifecycle state","WORK_CLEAN_WITH_AUDIT_DEBT"->"no actionable work remains but needs-audit or unresolved historical-debt blocks bare no-message and all readiness claims","PARKED"->"scheduler or task wake is unavailable but the base thread remains usable","DEGRADED"->"a scheduled check, expected firing, or evidence budget failed","EXPIRED"->"the absolute horizon elapsed","CANCELLED"->"the job was removed and cleanup verified"]
@RULE rid=rule:native-scheduler-only | lvl=MUST | when="activating scheduled-collab" | then="use a host-exposed native scheduler or automation capability with a bounded job identity; never invent or install a daemon service database queue or universal wake layer"
@RULE rid=rule:absolute-horizon | lvl=MUST | when="registering scheduled checks" | then="set an absolute Handler-approved deadline, finite maximum check count, finite consecutive failure budget, and cancellation path"
@RULE rid=rule:no-overlap | lvl=MUST | when="a scheduled check fires while the prior owned check is still active" | then="skip the new check, record the overlap, and never run concurrent reconciliation jobs for the same package instance"
@RULE rid=rule:scheduled-lease-identity | lvl=MUST | when="a scheduled check uses a no-overlap lease" | then="bind it to the exact arena canonical mailbox root run nonce native-job or owned-process identity and creation identity; compare the complete declared identity plus content hash; honor a live exact owner; for a dead owner use identity-bound conditional rename or a held exclusive handle to move only that observed lease to a run-specific tombstone before create-new acquisition, otherwise refuse reclamation; release only through identity-bound conditional delete and never remove a successor"
@RULE rid=rule:handler-stale-lease-clear | lvl=MUST | when="a retained stale lease blocks activation after ordinary identity-bound recovery refused it" | then="a current Handler may authorize clearing one exact retained lease only from its durable stale-lease record naming arena canonical mailbox root observed hash nonce owner creation identity and refusal reason, after independent proof that the recorded holder and descendants are absent; use the same identity-bound conditional rename or held-exclusive-handle primitive required by ordinary recovery, delete only the verified run-specific tombstone, persist authorization and outcome, and require a fresh bounded readiness cycle; if that primitive is unavailable evidence changed a live holder exists or identity is ambiguous refuse the clear"
@RULE rid=rule:bounded-check | lvl=MUST | when="a scheduled check runs" | then="perform one bounded transport sync and age-independent reconciliation over every addressed message, then every non-terminal CTA record, then a drift-tripwire audit of the five newest valid peer messages addressed to the participant independent of cursor position; never use the trailing window as the correctness boundary; persist message disposition and CTA lifecycle counts plus a heartbeat, then exit"
@RULE rid=rule:no-false-clean | lvl=MUST_NOT | when="a scheduled check finds any deferred disposition CTA in pending active or blocked expired blocker or lease needs-audit or unresolved historical-debt" | then="emit bare clean or no-message; emit FOUND for outstanding work and WORK_CLEAN_WITH_AUDIT_DEBT when only dormant audit debt remains"
@RULE rid=rule:outstanding-visible | lvl=MUST | when="valid outstanding work is not yet actionable or terminal" | then="emit FOUND with the exact owner CTA state and unexpired resume blocked or audit condition, return to the base exchange, and keep the obligation visible"
@RULE rid=rule:scheduled-health | lvl=MUST | when="registering firing reconciling handling any Handler turn ending a foreground turn or claiming ACTIVE or LISTENING" | then="through the surviving Handler or model path persist last-fired cadence bounded health-grace and exact local turn nonce origin start and normal end; a scheduled-origin turn observes its own firing; classify a due firing as suppressed only inside the exact currently proven-live Handler-origin turn, restart its observation clock from normal turn end, and never degrade that suppression; at the next re-entry transition a prior unmatched start whose nonce is not the current live turn to DEGRADED with one complete gap reconciliation; classify a firing as missed when it remained unobserved across a proven idle window beyond cadence plus grace, then transition to DEGRADED with one visible silent-death report and one complete gap reconciliation; report suppression by the current live turn as ACTIVE with health unevaluated since its first suppression; inspect native job state when exposed as optional strengthening, never as the portable predicate"
@RULE rid=rule:no-reply-keeps-schedule | lvl=MUST | when="scheduled reconciliation handles a valid message with expects-reply false or no wire response owed" | then="persist acted when an authorized effect completed or no-reply-required otherwise, advance the cursor last, and keep the existing bounded schedule unchanged; do not emit an acknowledgement or alter cadence solely because wire silence was requested"
@RULE rid=rule:transport-selected-check | lvl=MUST | when="a scheduled check selects its correctness action" | then="derive it from the resolved transport: local reconciles directly, sync-share waits for local provider materialization with bounded fresh-file retry, Git-only uses the approved scoped sync plus exact inbox range, Lyt uses lyt sync for the qualified vault plus exact inbox range, and Git inside sync-share requires the Handler-selected correctness channel"
@RULE rid=rule:no-stale-local-success | lvl=MUST_NOT | when="a required transport sync is unavailable or fails" | then="reconcile the stale local copy and report no-message or readiness; record PARKED before readiness or DEGRADED after a previously proven path fails"
@RULE rid=rule:wake-honesty | lvl=MUST | when="describing scheduled operation" | then="separate successful job scheduling, folder materialization, message detection, and agent task wake; claim only the capabilities proven end to end"
@RULE rid=rule:scheduled-fallback | lvl=MUST | when="the runtime lacks a native scheduler or cannot prove wake and cancellation" | then="leave the base collaboration active, report PARKED, and use Standard Exchange or Handler-mediated turn-taking"
@RULE rid=rule:no-infinite-schedule | lvl=MUST_NOT | when="a schedule has no absolute horizon or maximum check count" | then="register or continue it"
@RULE rid=rule:no-half-active-schedule | lvl=MUST_NOT | when="the scheduler capability check fails or any load-bearing prerequisite is absent" | then="register or run a scheduled job; terminate local package activation as PARKED while leaving the base collaboration active"
@RULE rid=rule:schedule-unilateral | lvl=MUST_NOT | when="selecting registering renewing expiring cancelling or cleaning up Scheduled Collab" | then="publish a mode proposal or require peer acceptance counter rejection renewal or matching cadence"
@RULE rid=rule:scheduled-peer-duty-separate | lvl=MUST | when="the local participant needs a peer to deliver review check reply or remain available by a deadline" | then="send an ordinary scoped request propose or FULL claim under the base protocol instead of encoding the duty as Scheduled Collab"

@SEC name="Execution"
@STEP rid=step:schedule-resolve | n:int=1 | op=std:ai.prompt@v1 | args=[task="Resolve the native scheduler capability, exact mailbox and participant filters, interval, absolute deadline, maximum check count, failure budget, no-overlap key, task-wake behavior, cancellation mechanism, result location, cleanup evidence, and for Codex the exact initiating Handler-visible target task identity. Surface the Codex target task before registration. If any load-bearing capability or exact same-task binding is absent, select PARKED."] | out=[ref:schedule-contract]
@CHECK rid=check:schedule-capable | assert="a native bounded scheduler, stable job identity, hard deadline, maximum check count, no-overlap guard, cancellation, result surface, end-to-end task wake or agent re-entry mechanism, and for Codex an exact binding to the initiating Handler-visible task are available and evidenced" | fail=ABORT | msg="Terminate this local package activation as PARKED before registration. Keep the base collaboration active."
@STEP rid=step:schedule-activate | n:int=2 | op=std:ai.prompt@v1 | in=[ref:schedule-contract] | args=[task="Activate scheduled-collab version 2 only for this participant after base establishment. Do not write a proposal or wait for peer acceptance. Optionally publish a canonical state availability FYI only for a material coarse transition, with expects_reply false and no peer obligation."] | out=[ref:schedule-local-state]
@STEP rid=step:schedule-register | n:int=3 | op=std:cmd.run@v1 | in=[ref:schedule-contract,ref:schedule-local-state] | args=[task="Register one native job with the absolute deadline, maximum check count, failure budget, and no-overlap key. For Codex bind it to the exact surfaced initiating Handler-visible task and refuse any implicit dedicated task target. Record scheduler job identity, target task identity, cadence, last-fired null, bounded health-grace, and the first idle observation deadline. At every model turn start create a fresh local turn nonce and record origin scheduled or Handler plus start time; normal yield records its matching end. Do not create a watcher daemon or an unbounded shell loop."] | out=[ref:schedule-job]
@STEP rid=step:schedule-check | n:int=4 | op=std:cmd.run@v1 | in=[ref:schedule-contract,ref:schedule-job] | args=[task="At each firing or later surviving Handler/model re-entry, first apply rule:scheduled-health before deciding whether mailbox sync is needed. A scheduled-origin turn observes its own firing. A due firing inside the exact current live Handler-origin nonce is suppressed; normal turn-end restarts the idle observation deadline. At the next re-entry, a prior unmatched start with a different nonce transitions to DEGRADED and creates local evidence for one complete gap reconciliation rather than indefinite suppression. A due firing that remained unobserved across a proven idle window beyond cadence plus grace emits DEGRADED and creates the same gap evidence. Suppression by the current live turn reports ACTIVE with health unevaluated, not green. Refuse overlap and select the correctness action from the resolved transport. Local reconciles directly; sync-share requires provider materialization with bounded fresh-file retry; Git-only runs the approved scoped sync then the exact inbox range; Lyt runs lyt sync for the qualified vault then the exact inbox range; Git inside sync-share uses only the Handler-selected channel. On unavailable or failed required sync emit PARKED before readiness or DEGRADED after proven readiness, never no-message from a stale copy. Otherwise reconcile the whole addressed inbox against durable dispositions and CTA states, revisit every non-terminal CTA record, and trailing-audit the five newest valid peer messages addressed to this participant independent of cursor position. Emit counts for pending active blocked deferred due-deferred needs-audit historical-debt and audit-state-with-live-work. Emit FOUND for actionable or valid outstanding work, WORK_CLEAN_WITH_AUDIT_DEBT when only dormant audit debt remains, or no-message only when the base readiness-clean predicate passes. After successful completion persist last-fired; before normal yield persist the matching turn-end and next idle observation deadline; then exit."] | out=[ref:schedule-result]
@STEP rid=step:schedule-react | n:int=5 | op=std:ai.prompt@v1 | in=[ref:schedule-result] | args=[task="On FOUND, re-enter the mandatory base exchange inside the exact surfaced Handler-visible target task, act once when actionable, keep project effects progress gates and results in that task, preserve valid outstanding state otherwise, and persist any transition before the next check. Never create fork select or delegate to a dedicated task unless the Handler explicitly requested it. On a genuinely missed idle-window firing or failure-budget exhaustion, mark DEGRADED and perform one complete gap reconciliation; load missed-message-recovery only when that check finds a message miss, cursor inconsistency, or other readiness contradiction requiring its audit workflow. Never infer that a job firing means the agent task was woken unless re-entry is observed."] | out=[ref:schedule-state]
@STEP rid=step:schedule-stop | n:int=6 | op=std:cmd.run@v1 | in=[ref:schedule-contract,ref:schedule-job,ref:schedule-state] | args=[task="At cancellation deadline maximum checks or degradation, remove and verify the native job and owned process, release the canonical no-overlap lease only through full-identity conditional delete or held handle, leave changed state for stale recovery, remove owned tombstones and run-owned scheduler scratch, preserve the causal error, and record CANCELLED or EXPIRED only after complete cleanup; any retained exact stale lease is DEGRADED with the causal end reason recorded separately."] | out=[ref:schedule-terminal]
@CHECK rid=check:schedule-clean | assert="the exact native-job and owned-process identities are absent, their no-overlap lease is absent, run-owned scheduler scratch returned to baseline, and the terminal result preserves the causal error" | fail=ABORT | msg="Scheduled Collab cleanup is incomplete; remain DEGRADED and surface the owned resource or stale-lease debt."

@STAMP ts:ts=2026-07-29T22:31:23Z | src="Alexandru Mares | allemaar.com" | method=merged
