@DOC ver=2.0 | id=agent-mailbox-collab-window | title="Agent Mailbox Collab Window" | kind=workflow | profile=exec | fmt=min | classification=public | guide="https://yon.younndai.com/yon-guide.txt" | parent=agent-mailbox
@INTENT goal="Add a bounded participant-local Work-or-Listen lease after the base Agent Mailbox collaboration is established, without negotiating peer cadence or claiming persistence or wake capability the runtime cannot prove"
@STAMP ts:ts=2026-07-27T00:00:00Z | src="Alexandru Mares | allemaar.com" | method=merged

@SEC name="Package contract"
@NOTE text="Package id collab-window version 2; compatible with Agent Mailbox base 1.x; participant-local directive whose activation cadence horizon rearm expiry stop and cleanup never require peer acceptance"
@MAP rid=map:collab-window-states | name=CollabWindowStates | pairs=["OFF"->"no availability lease selected","WORKING"->"authorized work is executing inside the lease","LISTENING"->"detection reconciliation heartbeat and end-to-end runtime wake or re-entry are proven","PARKED"->"base collaboration remains open but automatic wake or continuity is unavailable","DEGRADED"->"a miss cursor inconsistency heartbeat failure or capability loss revoked readiness","EXPIRED"->"the absolute lease deadline elapsed","STOPPED"->"the Handler or participant ended the lease and cleanup was verified"]
@MAP rid=map:listener-task-lifecycle | name=ListenerTaskLifecycle | pairs=["not-applicable"->"the adapter owns no dedicated listener task","active"->"the bounded listener task is running","closed-unarchived"->"owned runtime resources are gone but the task record remains visible","archived"->"an authorized lifecycle actor archived or closed the task record"]
@MAP rid=map:collab-window-defaults | name=CollabWindowDefaults | pairs=["settling horizon"->"10 minutes after establishment unless the Handler selects another bounded deadline","longer operation"->"renewable bounded lease with one absolute Handler-approved deadline","unbounded or non-stop"->"unsupported; explain the finite lease requirement","fallback"->"PARKED when continuity is unavailable; DEGRADED when promised capability fails"]
@RULE rid=rule:base-first | lvl=MUST | when="activating this package" | then="establish the mandatory CORE or FULL base collaboration first and preserve it when this local package is unavailable parks expires stops or degrades"
@RULE rid=rule:requested-vs-proven | lvl=MUST | when="reporting availability" | then="record both the Handler-requested state and the operationally proven state, and never render LISTENING from intention alone"
@RULE rid=rule:listening-proof | lvl=MUST | when="entering LISTENING" | then="prove message detection, age-independent disposition reconciliation, observable heartbeat, hard deadline, cancellation, and end-to-end runtime wake or re-entry for the active adapter"
@RULE rid=rule:no-infinite-window | lvl=MUST_NOT | when="the Handler requests non-stop or unbounded Work-or-Listen" | then="start an infinite execution or listener loop; propose a renewable bounded lease with an absolute deadline instead"
@RULE rid=rule:one-primary | lvl=MUST | when="collab-window is active for a participant" | then="keep it as that participant's sole primary operating package; missed-message-recovery is the only permitted overlay in version 2"
@RULE rid=rule:toggle-preflight | lvl=MUST | when="the Handler starts stops or toggles Collab Window" | then="run the same capability and cleanup checks as an explicit transition; toggle language never bypasses preflight"
@RULE rid=rule:window-unilateral | lvl=MUST_NOT | when="selecting starting rearming renewing expiring stopping or cleaning up a Collab Window" | then="publish a mode proposal or require peer acceptance counter rejection renewal or matching cadence"
@RULE rid=rule:peer-duty-separate | lvl=MUST | when="the local participant needs a peer to deliver review check reply or remain available by a deadline" | then="send an ordinary scoped request propose or FULL claim under the base protocol instead of encoding the duty as a Collab Window"
@RULE rid=rule:rearm-after-disposition | lvl=MUST | when="a valid inbound message is handled during the lease" | then="persist its durable disposition and any required primer update before re-arming detection"
@RULE rid=rule:no-reply-keeps-window | lvl=MUST | when="a valid inbound message during the lease has expects-reply false or needs no wire response" | then="treat silence as response semantics only; persist acted when an authorized effect completed or no-reply-required otherwise, advance the cursor last, require the clean recheck, and re-arm the same lease without acknowledgement or mode change when budgets remain"
@RULE rid=rule:revoke-on-miss | lvl=MUST | when="a message miss cursor inconsistency lost heartbeat or wake failure is reported" | then="transition immediately to DEGRADED, stop and verify termination of any nonconforming listener, and load missed-message-recovery"
@RULE rid=rule:codex-context-quiet | lvl=MUST | when="Codex exposes a native task-message bridge and this participant selects context-quiet Work-or-Listen" | then="use one bounded dedicated listener task to own detection and local heartbeat, damp native wakes per candidate UUID, pass only compact pointers to the primary participant task, and keep idle checks outside primary context"
@RULE rid=rule:codex-proof-before-listening | lvl=MUST | when="the Codex dedicated-listener adapter is armed but has not completed a real addressed-message cycle" | then="report PARKED with listener armed; promote to LISTENING only after primary re-entry full reconciliation durable disposition and immediate clean recheck are evidenced"
@RULE rid=rule:inspect-proven-listener | lvl=MUST | when="selecting a listener implementation" | then="inspect participant-local evidence for a previously proven compatible engine and the sanitized construction blueprint before rebuilding; record the compatibility decision and inherit no arena configuration authority exception or prior proof"
@RULE rid=rule:reuse-proven-listener | lvl=SHOULD | when="the inspected listener engine or blueprint is compatible with the current runtime and contract" | then="reuse it instead of reconstructing from abstract doctrine"
@RULE rid=rule:reuse-compatibility-gate | lvl=MUST | when="reusing a listener engine or blueprint" | then="audit and remove or freshly authorize every embedded sender root callsign and authority exception, reconcile assumptions against contract changes since it was authored, rebind every locus configuration and wake target, prove the interpreter API argument-array and spaced-path invocation boundary through one bounded startup-and-stop workflow, and require a fresh real addressed-message canary before LISTENING"
@RULE rid=rule:capability-minimal-listener | lvl=SHOULD | when="selecting the execution tier for a detector or dedicated listener task" | then="prefer the least-adequate available tier and record the selected tier capability basis and cost rationale; keep semantic authority disposition reply and project judgment with the primary participant"
@RULE rid=rule:listener-mechanical-obligations | lvl=MUST | when="any detector or dedicated listener tier is selected" | then="reliably compare canonical envelope candidates with durable UUID dispositions maintain bounded lifecycle evidence invoke the native wake bridge and accurately report PARKED or DEGRADED on its own failure"
@RULE rid=rule:listener-runtime-local | lvl=MUST | when="placing listener implementation state" | then="keep the executable engine configuration lease cursor logs and lifecycle evidence participant-local and outside the shared provider surface; a sanitized construction blueprint may be shared as work product but is never executed from the mailbox or provider-synchronized workspace"
@RULE rid=rule:stopped-separate-from-archive | lvl=MUST | when="a dedicated listener task terminates" | then="earn STOPPED when watcher events run-bound process and descendants owned lease tombstones and run-owned listener scratch are verified gone terminal evidence and final reconciliation are durable and no LISTENING claim remains; any retained exact stale lease requires DEGRADED while the causal end reason is recorded separately; record task archival or closure separately through the authorized native lifecycle actor"
@RULE rid=rule:archive-informational | lvl=MUST | when="a dedicated listener task stops" | then="record archival or closure as an informational lifecycle fact only; it neither proves owned-resource cleanup nor blocks a later separately authorized listener run"
@RULE rid=rule:owned-lease-identity | lvl=MUST | when="a listener creates or encounters a no-overlap lease" | then="bind the lease to the exact arena canonical mailbox root fresh run nonce owned process or native-job identifier and creation identity such as process start time; a matching name or PID alone is never ownership or liveness proof"
@RULE rid=rule:stale-lease-recovery | lvl=MUST | when="a no-overlap lease exists but its exact recorded owner identity is absent" | then="use an identity-bound conditional rename or an exclusive handle that proves the complete observed arena canonical mailbox root nonce owner and creation identity plus content hash still name the same file while moving it to a run-specific tombstone, then acquire the canonical lease with create-new and delete only the tombstone; if that primitive is unavailable content changed or a live exact owner exists refuse reclamation and never kill or classify another process by name"
@RULE rid=rule:conditional-lease-cleanup | lvl=MUST | when="a listener releases or cleans a no-overlap lease" | then="remove the canonical lease only through an identity-bound conditional delete or held exclusive handle proving the complete arena canonical mailbox root nonce owner creation identity and content hash still match the caller; if unavailable or changed leave it for stale recovery and report DEGRADED because a successor lease must never be removed"
@RULE rid=rule:handler-stale-lease-clear | lvl=MUST | when="a retained stale lease blocks activation after ordinary identity-bound recovery refused it" | then="a current Handler may authorize clearing one exact retained lease only from its durable stale-lease record naming arena canonical mailbox root observed hash nonce owner creation identity and refusal reason, after independent proof that the recorded holder and descendants are absent; use the same identity-bound conditional rename or held-exclusive-handle primitive required by ordinary recovery, delete only the verified run-specific tombstone, persist authorization and outcome, and require a fresh bounded readiness cycle; if that primitive is unavailable evidence changed a live holder exists or identity is ambiguous refuse the clear"
@RULE rid=rule:wake-pending | lvl=MUST | when="a listener submits a native task message" | then="persist wake-pending bound to exact listener run primary task callsign arena canonical mailbox root finite candidate UUID and anomaly set and native submission identity; native submission alone is not completion"
@RULE rid=rule:wake-pending-exit | lvl=MUST | when="wake-pending is open" | then="clear and rearm only after every candidate UUID has a durable terminal or quarantined disposition every anomaly has a closed or escalated outcome and the same run completes a clean recheck, or on bounded acknowledgement timeout persist visible failure release set-member damping for a later correctness retry and report PARKED before proof or DEGRADED after proof"
@RULE rid=rule:listener-task-authorization | lvl=MUST | when="a dedicated listener run uses a newly created or reused task" | then="require current Handler authority bound to exact listener task and host primary task participant purpose arena canonical mailbox root transport deadline and one run nonce, consume it at terminal run end, and require fresh current Handler authority for every replacement run; task existence is not standing run authority"

@SEC name="Execution"
@STEP rid=step:window-resolve | n:int=1 | op=std:ai.prompt@v1 | args=[task="Resolve this participant's Handler-selected bounded horizon or use the advisory 10-minute post-establishment or post-resume settling default. Record local requested state, absolute deadline, detection adapter, reconciliation channel, heartbeat, wake or re-entry mechanism, failure budget, cancellation, and cleanup owner. Never inspect or negotiate a peer cadence as a prerequisite."] | out=[ref:window-contract]
@CHECK rid=check:window-bounded | assert="the window has an absolute deadline, finite failure budget, observable heartbeat, cancellation path, and cleanup owner" | fail=ABORT | msg="Collab Window must remain finite and observable. Fall back to Standard Exchange or PARKED."
@STEP rid=step:window-start | n:int=2 | op=std:ai.prompt@v1 | in=[ref:window-contract] | args=[task="Activate collab-window version 2 only for this participant after base establishment. Do not write a proposal or wait for peer acceptance. Optionally publish a canonical state availability FYI only for a material coarse transition, with expects_reply false and no peer obligation."] | out=[ref:window-local-state]
@STEP rid=step:window-work | n:int=3 | op=std:ai.prompt@v1 | in=[ref:window-contract,ref:window-local-state] | args=[task="Enter WORKING only for authorized bounded work. Reconcile inbound before and after the work slice. Every valid addressed message is a call to action requiring append-only durable disposition transitions with one current effective state: acted, replied, no-reply-required, blocked by Handler-decision, rejected-scope only after refusal, superseded-by-correction only after a valid append-only correction, deferred with an explicit owner and deadline, needs-audit, or quarantined historical-debt."] | out=[ref:window-work-state]
@STEP rid=step:window-listen | n:int=4 | op=std:cmd.run@v1 | in=[ref:window-contract,ref:window-work-state] | args=[task="Enter LISTENING only when rule:listening-proof is satisfied. Otherwise enter PARKED without blocking the base thread. Run an immediate check, then bounded event or scheduled reconciliation under the lease; wake reasoning only on a valid message, heartbeat request, watchdog alarm, cancellation, or deadline."] | out=[ref:window-listen-state]
@CHECK rid=check:window-listening | assert="LISTENING is backed by current detection, reconciliation, heartbeat, hard-deadline, cancellation, and end-to-end wake or re-entry evidence" | fail=WARN | msg="Do not claim LISTENING. Report PARKED, or DEGRADED when a previously proven capability failed."
@STEP rid=step:window-rearm | n:int=5 | op=std:ai.prompt@v1 | in=[ref:window-listen-state] | args=[task="On a valid message, return to the mandatory base exchange, act once, persist the authoritative disposition and required primer state, and update the compact cursor checkpoint. Then require the same listener run to perform an immediate read-only age-independent whole-inbox reconciliation. Re-arm only when that result is clean and time and check budgets remain; unresolved work or contradiction blocks readiness."] | out=[ref:window-rearmed]
@STEP rid=step:window-stop | n:int=6 | op=std:cmd.run@v1 | in=[ref:window-contract,ref:window-rearmed] | args=[task="On Handler stop cancellation failure or deadline, dispose watcher events, stop and verify the exact run-bound process or native job and descendants, release the canonical lease only through the identity-bound conditional-delete or held-handle rule, leave changed state for stale recovery, remove owned tombstones and run-owned listener scratch, run the final read-only reconciliation, preserve terminal state and the causal error, revoke LISTENING, consume run-bound task authority, then optionally ask whichever authorized actor exposes the native task lifecycle primitive to archive or close the dedicated listener task. STOPPED depends on complete owned-resource cleanup; a retained exact stale lease forces DEGRADED while the causal end reason is recorded separately. Record archive status separately."] | out=[ref:window-terminal]
@CHECK rid=check:window-clean | assert="watcher events are disposed, the exact run-bound monitor or job identity and descendants are absent, its no-overlap lease is absent, owned tombstones and run-owned listener scratch returned to baseline, terminal state and final reconciliation are durable with the causal error preserved, no claim of continued listening remains, run-bound task authority is consumed, and any dedicated task archive status is recorded separately" | fail=ABORT | msg="Collab Window cleanup is incomplete; remain DEGRADED and surface the owned resource or stale-lease debt. A stop API's success and a matching process name are not cleanup evidence."

@STAMP ts:ts=2026-07-27T00:00:00Z | src="Alexandru Mares | allemaar.com" | method=merged
