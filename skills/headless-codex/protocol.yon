@DOC ver=2.0 | kind=skill | id=headless-codex | title="Headless Codex CLI" | profile=exec | fmt=min | guide="https://yon.younndai.com/yon-guide.txt"
@INTENT goal="Run one bounded Codex CLI task non-interactively from any shell-capable supervising harness with explicit target-runtime discovery, permissions, model and effort selection, evidence, and stop handling" | trigger="user runs /headless-codex, says run Codex headlessly, or automate Codex CLI"
@STAMP ts:ts=2026-09-17T09:18:37.950Z | src=human | method=manual

@SEC name="Boundary"
@RULE rid=rule:auth | lvl=MUST_NOT | when="checking authentication" | then="inspect, print, copy, or expose credentials"
@RULE rid=rule:advisory | lvl=MUST | when="classifying current CLI item errors" | then="only the exact skill-description-shortening advisory quoted in SKILL.md may remain a warning when every required skill is available and the task otherwise passes; preserve the warning, never generalize to other errors or use rule-skipping flags to suppress it"
@RULE rid=rule:scope | lvl=MUST | when="starting a run" | then="resolve one explicit working directory, bounded task, and write boundary"
@RULE rid=rule:parent-contract | lvl=MUST | when="dispatching from any parent harness" | then="follow references/run-contract.md; require a retained child handle, concurrent stdout and stderr, observable status, external deadline, and scoped interruption or process-tree termination; effective authority is the narrower composition of parent and child permissions"
@RULE rid=rule:no-recursive-dispatch | lvl=MUST_NOT | when="the child is running" | then="delegate again unless the nested run is separately scoped, bounded, authorized, observable, and cancellable"
@RULE rid=rule:freshness | lvl=MUST | when="before every run" | then="read references/model-state.json and run node scripts/check-model-freshness.mjs with its absolute path when Node is available, otherwise apply policy.reminderDays; missing, future, failed, or invalidated evidence is due immediately; the parent asks once per session to refresh the whole snapshot or continue dated, a child reports due state to its parent, and no process updates automatically"
@RULE rid=rule:catalog | lvl=MUST | when="selecting a model or effort" | then="use only current target-runtime codex debug models entries with visibility list and respect an explicit caller selection"
@RULE rid=rule:effort-config | lvl=MUST | when="passing reasoning effort" | then="treat the 0.144.4 syntax as historical maintainer evidence; pass one config argument in the form -c 'model_reasoning_effort=\"<effort>\"' only after confirming the current target runtime supports -c / --config and the named field"
@RULE rid=rule:scoped-prerequisite-observation | lvl=MUST | when="a fixture needs prerequisite reads outside its writable workspace" | then="keep those roots out of --add-dir and workspace_roots; an inline profile may use one filesystem table of reviewed absolute forward-slash Windows paths with read values, default_permissions, and :workspace extension, but do not claim enforcement until retained command events prove it because inherited legacy sandbox settings can affect the result"
@RULE rid=rule:no-catalog-injection | lvl=MUST_NOT | when="using skills" | then="inject or request the entire installed skill catalog"
@RULE rid=rule:foreground | lvl=MUST | when="running headlessly" | then="keep the process foreground, observable, and bounded"
@RULE rid=rule:explicit-choice | lvl=MUST | when="an explicitly selected model or effort is not supported by the local catalog" | then="report the exact unavailable selection and stop without substitution"
@RULE rid=rule:model-map | lvl=MUST | when="choosing an unspecified model or effort" | then="consult references/model-selection.md for task, cost and long-horizon coding evidence; preserve explicit selection, do not transfer coding benchmarks to unrelated tasks, and when useful disclose a cheaper or stronger locally available option with cost/quota, evidence, latency and reversal condition"
@RULE rid=rule:bounds | lvl=MUST | when="before launch" | then="record a finite timeout and deadline, stdout and stderr status surface, retained process handle, scoped interruption and termination method, and retry limit zero by default or at most one explicitly authorized retry; stop if the runner cannot return control for monitoring and enforce the deadline"
@RULE rid=rule:result-artifact | lvl=MUST | when="launching a substantial deliverable" | then="assign its exact result-artifact path before launch; the worker saves the complete result only when authorized write scope permits it, otherwise the supervisor durably captures complete structured output through an already-authorized path; read-only review gains no write authority"
@RULE rid=rule:result-observability | lvl=MUST | when="supervising a substantial deliverable" | then="stream stdout and stderr to retained logs, retain progress or status with child identity, deadline, and cancellation state, preserve partial outputs on failure, and never treat display truncation as lost persisted output"
@RULE rid=rule:result-verify | lvl=MUST | when="declaring a substantial deliverable complete" | then="verify its artifact exists, is readable, and contains the complete result, then verify task correctness; return compact artifact path, status, checks, and gaps rather than a giant transcript; file-backed capture does not broaden permissions or authorize secrets in logs"
@RULE rid=rule:result-recovery | lvl=MUST | when="recovering a prior substantial deliverable" | then="inspect its saved artifact before rerunning inference"

@SEC name="Preflight"
@STEP rid=step:inspect | n:int=1 | op=std:cmd.run@v1 | args=[task="From the supervising harness, check model-state freshness, then run target codex --version, codex exec --help, codex login status, and codex debug models without exposing credentials. Inspect effective inherited settings, hooks, MCP servers and skills where supported; report unenforceable or unobservable boundaries as limitations."] | out=[ref:runtime]
@CHECK rid=check:runtime | assert="codex executable, authentication state, and local model catalog are observable" | fail=ABORT | msg="Headless run cannot be safely configured from assumed runtime state."

@SEC name="Configure"
@STEP rid=step:select | n:int=2 | op=std:ai.prompt@v1 | in=[ref:runtime] | args=[task="Use an explicitly selected model and effort only when supported; stop on an unsupported explicit choice. For an unspecified choice only, use references/model-selection.md and choose a locally exposed model or supported effort fitting the task. Select read-only unless an exact write boundary was authorized. For literal prompts avoid optional skills and broad customization; for selected skills inspect only task-relevant installed skills and required references, then mention those skills literally without widening authority."] | out=[ref:run-plan]
@CHECK rid=check:boundary | assert="run plan contains explicit cwd, task, model, effort, sandbox, output destination or stdout, stderr capture, finite timeout and deadline, process handle, monitoring and scoped cancellation methods, and retry limit at most one; a substantial deliverable has an exact result-artifact path" | fail=ABORT | msg="Missing boundary, permission, supervision, or required artifact selection."

@SEC name="Run and verify"
@STEP rid=step:execute | n:int=3 | op=std:cmd.run@v1 | in=[ref:run-plan] | args=[task="Run target codex exec in the foreground under the supervising runner and retain its process handle. Prefer --ephemeral for one-off work and --sandbox read-only for inspection. Pass the selected effort through the verified -c model_reasoning_effort config argument. Use workspace-write only when explicitly authorized."] | out=[ref:run]
@STEP rid=step:monitor | n:int=4 | op=std:io.emit@v1 | in=[ref:run] | args=[task="Stream stdout and stderr to retained logs; retain progress or status with child identity, deadline, and cancellation state; report a checkpoint within 60 seconds and at material changes. Enforce the recorded deadline externally. On timeout or cancellation interrupt the scoped process, confirm exit, and use scoped termination if interruption fails. Preserve partial output and exit code and report whether it stopped."] | out=[ref:result]
@CATCH target=step:execute | on="authentication, model, permission, or billing failure" | do="preserve the exact error and stop without substitution or automatic retry"
@RETRY target=step:execute | max=1 | when="new evidence addresses the failure, the caller explicitly authorizes retry, and the recorded retry limit and deadline permit it"
@CHECK rid=check:result | assert="exit zero, a complete terminal success event, nonempty expected final output, and no terminal error, tool error, permission denial, timeout, cancellation, malformed event, or unexplained truncation" | fail=ABORT | msg="Exit zero alone is insufficient; preserve evidence and report incomplete or failed."
@STEP rid=step:report | n:int=5 | op=std:io.emit@v1 | in=[ref:result] | args=[task="Report version, redacted auth state, model and effort, sandbox, cwd category, command shape, exit code, output, warnings, and unverified claims. For a substantial deliverable, verify artifact and task correctness, then return compact artifact path, status, checks, and gaps rather than a giant transcript."] | out=[ref:report]

@SEC name="Resume and stop"
@RULE rid=rule:resume | lvl=MUST | when="resuming a non-ephemeral session" | then="use the exact recorded session ID, not --last; repeat preflight and inspect resume help to establish approved model, effort, cwd, and sandbox through supported options; stop if those boundaries cannot be established; apply the same deadline and monitoring controls"
@RULE rid=rule:cancel | lvl=MUST | when="a foreground run must stop" | then="use the supervising runner's normal interruption mechanism and report cancellation"
@RULE rid=rule:background | lvl=MUST_NOT | when="no monitored runner and cancellation path exist" | then="launch a background headless run"

@SEC name="Self-improvement"
@STEP rid=step:sip | n:int=99 | op=std:ai.prompt@v1 | args=[task="If a concrete blocking or recurring skill weakness surfaced, propose a specific repair for Handler approval; otherwise remain silent. Never auto-apply. No sibling skill is required."] | out=[ref:sip]

@RULE rid=rule:workspace-trust | lvl=MUST | when="before inference" | then="check Git workspace/trust prerequisite; non-Git tasks require reviewed supported skip-git-repo-check route or authorized private Git fixture; do not repeat an unchanged trust failure"

@RULE rid=rule:literal-config | lvl=MUST | when="using optional ignore-user-config for a literal task" | then="verify current help and that no required boundary/capability is dropped; authentication remains CODEX_HOME; do not infer complete isolation or use ignore-rules to evade approval policy"
@RULE rid=rule:nested-spawn | lvl=MUST | when="a helper launches nested provider CLIs" | then="verify each nested executable launch independently; helper launch or prerequisite reads do not prove nested spawn authority; preserve EPERM or policy failures and route to a capable outer supervisor without weakening sandbox, rules, or permissions"

@RULE rid=rule:access-contract | lvl=MUST | when="every run" | then="read bundled access.md; census current OS, executable path, version/help, supported nonsecret auth state, model/quota surfaces, relevant configuration/customizations and parent supervision/cancellation; use only existing state; missing or unobservable capabilities stop only dependent routes; dated validation is historical, never a default or entitlement; never auto-install, log in, add API fallback or change configuration"

@RULE rid=rule:portable-dispatch | lvl=MUST | when="Windows pipe capture or nested runtime access fails" | then="use bundled file-backed process-supervision guidance for capture; version success does not prove runtime state or network access; a separately authorized outer host may accept one fixed request ID through fixed-dispatch guidance after reviewing immutable worker specification; never derive command arguments from the request, copy credentials, silently change selections or weaken parent policy"
