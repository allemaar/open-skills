@DOC ver=2.0 | id=orient-record-example | title="Example emitted orientation record (orient-status on a git repo)" | kind=context | profile=exec | fmt=min | guide="https://yon.younndai.com/yon-guide.txt"
@NOTE text="Synthetic contract example: values and source labels illustrate hypothetical inputs, not observations of a live project. Every emitted payload field or collection entry has an exact rider; illustrative-premise is not runtime attestation."
@INTENT goal="A worked, validatable instance of orient-record showing the reserved-tag emission with a sidecar @MAP for every list field (never an in-set bracket-list)." | audience=agent
@STAMP ts:ts=2026-11-04T15:16:47Z | src="Alexandru Mares | allemaar.com" | method=manual
@NOTE text="Apache-2.0. Conforms to orient-spec/orient-record.yon (schema_version orient-record/1). Every list field is a sidecar @MAP — never a bare in-set bracket-list."

@CFG id=orient | set=[schema_version=orient-record/1,computed_at:ts=2026-06-22T00:00:00Z,ephemeral:bool=true,tool=orient-status,tier=orient,scope=open-skills,evidence_mode=git-only,gate_status=degraded,gate_score:int=40,gate_blocking_field=none,gate_confidence_floor=inferred,family_used=orient-status,family_suggested_next=orient-gaps,family_reason_code=blockers_present,overall_trust=med,degraded:bool=true,degrade_reason="inferred open forks are advisory; no attested blocking field"]
@CFG id=subject | set=[name=open-skills,kind=monorepo,purpose="public skills pack",purpose_source=readme,intent_status=stated,parent_subject="open-source push"]
@CFG id=snapshot | set=[status=in-progress,stage=P1,stage_idx:int=1,frontier=orient-status,on_branch:bool=true,branch=feat/orient,dirty:int=3,ahead:int=2,behind:int=0]
@CFG id=remaining | set=[open_count:int=4,done_count:int=1,fraction_done:flt=0.2,denominator_trust=inferred,remainder_caveat="visible-only count",next_open=author-protocol]
@MAP name=open_set | pairs=["o1"->"P2 orient-map","o2"->"P3 footer","o3"->"routing gate","o4"->"P4 orient-gaps"]
@CFG id=forecast | set=[kind=prediction,provenance=extrapolated,eta_low=1d,eta_high=3d,eta_unit=calendar-days,confidence=low,unschedulable:bool=false]
@CFG id=trajectory | set=[layout=tree,on_branch:bool=true,trunk_ref=main,cursor_node=n3,fork_node=n2,ahead:int=2,behind:int=0]
@CFG id=node.n1 | set=[kind=done,label=P0-contract,lane=trunk]
@CFG id=node.n2 | set=[kind=fork,label=cold-vet,lane=trunk]
@CFG id=node.n3 | set=[kind=here,label=fix-pass,lane=branch]
@MAP name=edges | pairs=["n1"->"n2","n2"->"n3"]
@CFG id=delta | set=[anchor_kind=git,anchor_ref=HEAD@2h,anchor_confidence=approx,window=2h]
@MAP name=changes | pairs=["c1"->"orient-record fixes","c2"->"family-manifest fixes"]
@MAP name=no_change_zones | pairs=["z1"->"subagent-protocol","z2"->"README"]
@MAP name=missed_while_away | pairs=["m1"->"1 commit on main since the fork"]
@CFG id=resume | set=[next_action="re-validate then quick verify",counter_case="if a fix broke validation revert that edit",dropped_alt="ship without the fix pass",resume_confidence=high]
@CFG id=gaps | set=[stall_status=stalled]
@MAP name=open_forks | pairs=["f1"->"schema_version bump decision"]
@MAP name=loose_ends | pairs=["l1"->"3 uncommitted files"]
@MAP name=silent_gaps | pairs=["s1"->"new skill has no honesty fixture yet"]
@MAP name=provenance | pairs=["snapshot.on_branch"->"git-attested:high:git-rev-parse","subject.name"->"git-attested:high:dir-name","gaps.loose_ends"->"git-attested:high:git-status","gaps.open_forks"->"inferred:med:no-decision-record","forecast.eta_low"->"inferred:low:commit-cadence","forecast.eta_high"->"inferred:low:commit-cadence","subject.kind"->"inferred:low:illustrative-premise","subject.purpose"->"inferred:low:illustrative-premise","subject.purpose_source"->"inferred:low:illustrative-premise","subject.intent_status"->"inferred:low:illustrative-premise","subject.parent_subject"->"inferred:low:illustrative-premise","snapshot.status"->"inferred:low:illustrative-premise","snapshot.stage"->"inferred:low:illustrative-premise","snapshot.stage_idx"->"inferred:low:illustrative-premise","snapshot.frontier"->"inferred:low:illustrative-premise","snapshot.branch"->"inferred:low:illustrative-premise","snapshot.dirty"->"inferred:low:illustrative-premise","snapshot.ahead"->"inferred:low:illustrative-premise","snapshot.behind"->"inferred:low:illustrative-premise","remaining.open_count"->"inferred:low:illustrative-premise","remaining.done_count"->"inferred:low:illustrative-premise","remaining.fraction_done"->"inferred:low:illustrative-premise","remaining.denominator_trust"->"inferred:low:illustrative-premise","remaining.remainder_caveat"->"inferred:low:illustrative-premise","remaining.next_open"->"inferred:low:illustrative-premise","open_set.o1"->"inferred:low:illustrative-premise","open_set.o2"->"inferred:low:illustrative-premise","open_set.o3"->"inferred:low:illustrative-premise","open_set.o4"->"inferred:low:illustrative-premise","forecast.kind"->"inferred:low:illustrative-premise","forecast.provenance"->"inferred:low:illustrative-premise","forecast.eta_unit"->"inferred:low:illustrative-premise","forecast.confidence"->"inferred:low:illustrative-premise","forecast.unschedulable"->"inferred:low:illustrative-premise","trajectory.layout"->"inferred:low:illustrative-premise","trajectory.on_branch"->"inferred:low:illustrative-premise","trajectory.trunk_ref"->"inferred:low:illustrative-premise","trajectory.cursor_node"->"inferred:low:illustrative-premise","trajectory.fork_node"->"inferred:low:illustrative-premise","trajectory.ahead"->"inferred:low:illustrative-premise","trajectory.behind"->"inferred:low:illustrative-premise","node.n1.kind"->"inferred:low:illustrative-premise","node.n1.label"->"inferred:low:illustrative-premise","node.n1.lane"->"inferred:low:illustrative-premise","node.n2.kind"->"inferred:low:illustrative-premise","node.n2.label"->"inferred:low:illustrative-premise","node.n2.lane"->"inferred:low:illustrative-premise","node.n3.kind"->"inferred:low:illustrative-premise","node.n3.label"->"inferred:low:illustrative-premise","node.n3.lane"->"inferred:low:illustrative-premise","edges.n1"->"inferred:low:illustrative-premise","edges.n2"->"inferred:low:illustrative-premise","delta.anchor_kind"->"inferred:low:illustrative-premise","delta.anchor_ref"->"inferred:low:illustrative-premise","delta.anchor_confidence"->"inferred:low:illustrative-premise","delta.window"->"inferred:low:illustrative-premise","changes.c1"->"inferred:low:illustrative-premise","changes.c2"->"inferred:low:illustrative-premise","no_change_zones.z1"->"inferred:low:illustrative-premise","no_change_zones.z2"->"inferred:low:illustrative-premise","missed_while_away.m1"->"inferred:low:illustrative-premise","resume.next_action"->"inferred:low:illustrative-premise","resume.counter_case"->"inferred:low:illustrative-premise","resume.dropped_alt"->"inferred:low:illustrative-premise","resume.resume_confidence"->"inferred:low:illustrative-premise","gaps.stall_status"->"inferred:low:illustrative-premise","open_forks.f1"->"inferred:low:illustrative-premise","loose_ends.l1"->"inferred:low:illustrative-premise","silent_gaps.s1"->"inferred:low:illustrative-premise"]
